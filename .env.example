# =============================================================================
# FullEnrich API (required)
# =============================================================================
FULLENRICH_API_KEY=your_api_key_here
FULLENRICH_BASE_URL=https://app.fullenrich.com/api/v2

# =============================================================================
# Supabase (required)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# =============================================================================
# Application (optional - defaults shown)
# =============================================================================
BATCH_SIZE=100
REQUEST_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# HubSpot Sync (optional)
# =============================================================================
ENABLE_HUBSPOT_SYNC=false
HUBSPOT_SERVICE_KEY=
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_REQUEST_TIMEOUT=30
HUBSPOT_BATCH_SIZE=100
HUBSPOT_DRY_RUN=true
HUBSPOT_RATE_LIMIT_PER_MINUTE=100
HUBSPOT_MAX_RETRIES=4
HUBSPOT_SUPABASE_ID_PROPERTY=contactID
HUBSPOT_CONTACT_FIELD_MAP={}

# =============================================================================
# Streamlit App Auth (optional)
# =============================================================================
APP_AUTH_ENABLED=false
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change_me
